# Copy to saas/api/.env and fill in. .env is git-ignored -- never commit it.

# Session signing key: a long random string (python -c "import secrets;print(secrets.token_urlsafe(48))").
RECOVA_SECRET_KEY=

# Where the web app is reached from a browser. Builds the Google redirect URI and email links.
RECOVA_PUBLIC_URL=http://localhost:3000

# Google sign-in -- Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ("Web application")
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/google/callback
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email over SMTP (sign-in codes, verification, password reset).
# Leave SMTP_HOST empty in development: emails are printed to the API log instead.
# Gmail: smtp.gmail.com / 587 / your address / a 16-character App Password.
# Production: your provider's SMTP relay (Amazon SES, Brevo, ZeptoMail, Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Platform super admins: the people who run this Recova server (comma-separated).
# Granted only here -- never by sign-up or invite -- and only once that email is
# verified. They see /app/platform: every business and user, as counts only.
RECOVA_SUPER_ADMIN_EMAILS=

# Safety net while developing: when set, ONLY these addresses / @domains get real
# email; everything else is recorded as "blocked". Leave empty in production.
RECOVA_EMAIL_ALLOWLIST=

# The daily run + morning digest. The background loop checks every
# RECOVA_SCHEDULER_SECONDS and runs once per business per day after
# RECOVA_DIGEST_HOUR (server local time). RECOVA_SCHEDULER=off disables it.
RECOVA_SCHEDULER=on
RECOVA_DIGEST_HOUR=8
RECOVA_SCHEDULER_SECONDS=900
