# Copy this file to .env and fill in the blanks. .env is gitignored.
# Do NOT export GEMINI_API_KEY or GOOGLE_API_KEY globally in your shell.

# "mock" = deterministic canned responses, no API key needed (default).
# "live" = real Gemini API calls using GEMINI_API_KEY.
LLM_MODE=mock

# The SDK also honours GOOGLE_API_KEY, which wins if both are set.
# engine/llm.py passes this one explicitly so that cannot happen.
GEMINI_API_KEY=

# Every outbound email goes here and nowhere else.
TEST_INBOX_EMAIL=

# Gmail needs an app password here, not your account password.
SMTP_USER=
SMTP_PASS=

# Optional; defaults come from config/rules.yaml (smtp.gmail.com:587).
SMTP_HOST=
SMTP_PORT=
