# secrets
.env

# generated audit logs -- audit/audit_log.jsonl (engine/audit.py) and
# audit/outcomes.jsonl (engine/outcomes.py). The glob already covers both;
# they are named here so a new log file is never assumed to be committable.
audit/*
!audit/.gitkeep

# generated seed data
data/seed/*
!data/seed/.gitkeep

# generated hidden personas (simulator only, never committed)
sim/hidden_personas.json

# generated reports -- the directory is ignored, but four artifacts are
# committed on purpose so a reviewer sees the measured result without running
# the ~3.5-min simulation. They regenerate byte-for-byte (deterministic; only
# the `generated` timestamp changes):
#   python sim/run_sim.py --compare --seed 7 --extra-seeds 42,13,99,2024,555 --days 120
#   python report/build_report.py
#   python scripts/build_dashboard.py --seed 7
report/out/*
!report/out/results.json
!report/out/report.html
!report/out/dashboard.html
!report/out/dashboard.json

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
