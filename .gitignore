# secrets
.env

# generated audit logs -- audit/audit_log.jsonl (engine/audit.py) and
# audit/outcomes.jsonl (engine/outcomes.py). The glob already covers both;
# they are named here so a new log file is never assumed to be committable.
audit/*
!audit/.gitkeep

# generated seed data
data/seed/*
!data/seed/.gitkeep

# generated hidden personas (simulator only, never committed)
sim/hidden_personas.json

# generated reports
report/out/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
